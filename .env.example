# Crie uma conta gratuita em https://www.emailjs.com/, configure um Service e um Template
# e cole as chaves abaixo em um arquivo .env (não versionado) para habilitar o formulário de contato.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
